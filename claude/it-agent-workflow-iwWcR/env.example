# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-...
# AutoTask
AUTOTASK_USERNAME=apiuser@yourdomain.com
AUTOTASK_INTEGRATION_CODE=your-integration-code-here
# Zone is auto-discovered from your username; override only if needed
AUTOTASK_ZONE_URL=
# ITGlue
ITGLUE_API_KEY=your-itglue-api-key
# Use https://api.eu.itglue.com for EU region
ITGLUE_BASE_URL=https://api.itglue.com
# Passportal (N-able)
PASSPORTAL_API_KEY=your-passportal-api-key
PASSPORTAL_BASE_URL=https://vault.passportal.com
# Kaseya VSA
VSA_BASE_URL=https://your-vsa-instance.kaseya.net
VSA_USERNAME=your-vsa-username
VSA_PASSWORD=your-vsa-password
# Optional: default AutoTask queue ID to poll for new tickets
AUTOTASK_QUEUE_ID=